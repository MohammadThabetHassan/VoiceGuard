# VoiceGuard FastAPI backend — systemd unit
#
# Placeholders replaced by deploy/setup.sh:
#   YOUR_USERNAME -> the Linux user that owns ~/voiceguard
#
# The repo is a proper Python package (pyproject.toml, `pip install -e .`), so
# the app is launched as the module voiceguard.api.main:app. The venv lives at
# the repo root (~/voiceguard/venv) and the source is under ~/voiceguard/src.
#
# Only ONE worker: the PyTorch detection models are loaded into process memory
# and do not fork safely. Endpoints are async, so one worker is enough.

[Unit]
Description=VoiceGuard FastAPI Backend
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=5
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/voiceguard
Environment="PATH=/home/YOUR_USERNAME/voiceguard/venv/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/YOUR_USERNAME/voiceguard/src"
# Production mode: disables the demo admin/analyst logins and makes the app
# refuse to start with a default SECRET_KEY.
Environment="VG_ENV=production"
# Change SECRET_KEY to a long random value (e.g. `openssl rand -hex 32`) so JWTs
# survive restarts and are not the insecure dev default. setup.sh replaces this.
Environment="SECRET_KEY=change-me-openssl-rand-hex-32"
# API login passwords. REQUIRED in production — without these no one can log in.
# Set strong values (the demo passwords are disabled when VG_ENV=production).
Environment="VG_ADMIN_PASSWORD=change-me-admin-password"
Environment="VG_ANALYST_PASSWORD=change-me-analyst-password"
# Used by the backend CORS allow-list (harmless behind same-origin Nginx, but
# keeps direct-to-API requests working too). Replaced by setup.sh.
Environment="VOICEGUARD_DOMAIN=YOUR_DOMAIN"
# Production detector checkpoint (XLS-R + AASIST, Kokoro-hardened). This is the
# default model for /detect. The .pt is ~1.2GB and is NOT in the repo — copy it
# onto the host and point this at it, else /detect returns 503 (no model). Path
# replaced by setup.sh from MODEL_CKPT.
Environment="XLS_R_AASIST_PATH=/home/YOUR_USERNAME/voiceguard/models/xls_r_aasist.pt"
# --proxy-headers + --forwarded-allow-ips 127.0.0.1: trust X-Forwarded-For from the
# local Nginx so slowapi rate-limits per real client IP, not all as 127.0.0.1.
ExecStart=/home/YOUR_USERNAME/voiceguard/venv/bin/uvicorn voiceguard.api.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info \
    --access-log \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=voiceguard

[Install]
WantedBy=multi-user.target
