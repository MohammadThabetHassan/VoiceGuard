# VoiceGuard environment configuration.
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets. All values below are
# placeholders; replace anything marked "changeme".
#
# Only the variables the code actually reads are listed here. Most have safe
# defaults (shown in [brackets]) and can be left unset for local development.

# ── Core / auth ──────────────────────────────────────────────────────────────

# Deployment mode. "development" enables the demo login below and a relaxed
# SECRET_KEY. Set to "production" for any real deployment — that disables the
# demo credentials and makes the app refuse to start with a default SECRET_KEY.
VG_ENV=development

# JWT signing key. Generate a real one with:  openssl rand -hex 32
# The app refuses to start in production (VG_ENV=production) if this is left at
# a default/placeholder value.
SECRET_KEY=changeme-run-openssl-rand-hex-32

# API login credentials. In production these are REQUIRED (a user with no
# password set simply cannot log in). In development they fall back to the demo
# values admin/voiceguard2026 and analyst/analyst2026 if unset.
VG_ADMIN_PASSWORD=changeme-admin-password
VG_ANALYST_PASSWORD=changeme-analyst-password

# ── Privacy / PDPL ───────────────────────────────────────────────────────────

# Max age (seconds) before uploaded audio is auto-deleted (PDPL compliance). [60]
PDPL_MAX_AGE_SECONDS=60

# ── CORS / hosting ───────────────────────────────────────────────────────────

# Public domain for the self-hosted deployment. Allow-lists https://<domain>
# and https://www.<domain> for direct-to-API browser requests. [unset]
VOICEGUARD_DOMAIN=
# Extra allowed origins (e.g. an ngrok tunnel). Comma-separated, or a single one. [unset]
FRONTEND_ORIGINS=
FRONTEND_ORIGIN=

# ── Detection model checkpoints ──────────────────────────────────────────────
# Each model family loads only if its path env-var points at a checkpoint.
# The production detector is xls_r_aasist (~1.2 GB, not in git). Without any of
# these set, use ?model=classical.

XLS_R_AASIST_PATH=
WAV2VEC2_LARGE_PATH=
CLASSICAL_MODEL_PATH=
DSFNET_MODEL_PATH=
# Other selectable families load the same way — set the matching path to enable:
#   AASIST_MODEL_PATH  DSFNET_V2_MODEL_PATH  WAVLM_BASE_PLUS_PATH
#   WAVLM_LARGE_PATH   WAV2VEC2_MODEL_PATH   XLS_R_PATH
# Cloning engine weights: VG_<ENGINE>_WEIGHTS (e.g. VG_XTTS_WEIGHTS).
# Root dir scanned for auto-discovered checkpoints. [checkpoints]
CHECKPOINTS_DIR=checkpoints

# ── Synthesis (Generate) ─────────────────────────────────────────────────────

# Durable home for out-of-process cloning engines (venvs + weights).
# [~/.voiceguard/synth]
VG_SYNTH_HOME=

# ── Media + provenance ───────────────────────────────────────────────────────

# Dir for generated audio served at /api/media. [/tmp/voiceguard_media]
VG_MEDIA_DIR=
# TTL (seconds) before generated media is cleaned up. [900]
VG_MEDIA_TTL_S=900
# C2PA signing material for watermarked audio (auto-generated under
# ~/.voiceguard/c2pa if unset).
VG_C2PA_DIR=
VG_C2PA_CERT=
VG_C2PA_KEY=

# ── Frontend (build-time, Vite) ──────────────────────────────────────────────

# API base path the SPA calls. Same-origin "/api" behind Nginx by default. [/api]
VITE_API_BASE=/api

# ── Twilio (VoIP) ────────────────────────────────────────────────────────────
# NOTE: the Twilio Media Streams bridge is INBOUND — Twilio connects to the
# /twilio/stream WebSocket, so no TWILIO_* credentials are read by the current
# code. If you add outbound calls or webhook-signature validation, store the
# Twilio Account SID / Auth Token here and wire them into voip/twilio_bridge.py.
# TWILIO_ACCOUNT_SID=changeme
# TWILIO_AUTH_TOKEN=changeme
